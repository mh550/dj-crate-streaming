# Copy to /srv/docker/.env (chmod 600). Never commit the real file.
# Phase 0 — Navidrome admin, used by the crates service
ND_USER=
ND_PASS=
# What the phone can reach (tailscale serve); defaults to the box's MagicDNS name
SUBSONIC_PUBLIC_URL=
# Where the repo checkout lives, only if compose isn't run with deploy/ as project dir
CRATES_SRC=
# Phase 1 — Soulseek through the VPN (gluetun + slskd)
WG_KEY=
GLUETUN_KEY=
SLSK_USER=
SLSK_PASS=
