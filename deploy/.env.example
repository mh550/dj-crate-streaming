# Copy to /srv/docker/.env (chmod 600). Never commit the real file.
# Phase 0 — Navidrome admin, used by the crates service
ND_USER=
ND_PASS=
# Required: the dj-crate-streaming checkout, used as the `crates` build context
CRATES_SRC=/home/mh550/projects/dj-crate-streaming
# Optional: what the phone can reach (tailscale serve); defaults to the box's MagicDNS name
# SUBSONIC_PUBLIC_URL=
# Phase 1 — Soulseek through the VPN (gluetun + slskd)
WG_KEY=
GLUETUN_KEY=
SLSK_USER=
SLSK_PASS=
