# Copy to /srv/docker/.env (chmod 600). Never commit the real file.
# Phase 0 — Navidrome admin, used by the crates service
ND_USER=
ND_PASS=
# Required: the dj-crate-streaming checkout, used as the `crates` build context
CRATES_SRC=/home/mh550/projects/dj-crate-streaming
# Optional: what the phone can reach (tailscale serve); defaults to the box's MagicDNS name
# SUBSONIC_PUBLIC_URL=
# Phase 1 — Soulseek through the VPN (gluetun + slskd)
WG_KEY=
GLUETUN_KEY=
SLSK_USER=
SLSK_PASS=
# API key our tools use against slskd (any 16–255 char string; generate one)
SLSKD_API_KEY=
# H3 — Gatus (dashboard on 127.0.0.1:4590, alerts by ntfy). Gatus won't start until both are set.
# A private ntfy.sh topic (hard to guess: anyone who knows it can read the alerts); subscribe to it in the ntfy app
GATUS_NTFY_TOPIC=
# A random token (e.g. `openssl rand -hex 24`); the same value goes in /etc/restic/env with GATUS_BACKUP_URL=http://127.0.0.1:4590
GATUS_BACKUP_TOKEN=
